# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Mailbox (IMAP over SSL) -------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.address@gmail.com
# Gmail: use a 16-character App Password, not your normal password.
# Google Account -> Security -> 2-Step Verification -> App passwords.
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# Folders to sync, comma-separated, each with its own bookmark. Including
# Sent Mail makes threads complete with your own replies.
IMAP_FOLDERS=INBOX,[Gmail]/Sent Mail
IMAP_TIMEOUT=30

# --- Cache database ------------------------------------------------------------
# Exactly one DATABASE_URL line may be active; the others must start with '#'.
#
# PostgreSQL (psycopg 3 driver), the default. Fill in from pgAdmin:
#   USER      server Properties -> Connection -> Username (often "postgres")
#   PASSWORD  that user's password; URL-encode @ -> %40, : -> %3A, / -> %2F, % -> %25
#   HOST/PORT server Properties -> Connection -> Host name/address and Port
#   DBNAME    the *database* (an entry under the server's "Databases" node),
#             not a schema. Tables are created in its "public" schema.
#   sslmode   prefer for a local server; require for a hosted one.
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/postgres?sslmode=prefer
# PostgreSQL schema to hold the tables (created if missing). Leave empty for
# the server default, "public". Ignored on SQLite.
DB_SCHEMA=poc
#
# SQLite (single local file), if you want to switch back:
# DATABASE_URL=sqlite:///data/mailbox_cache.db

# --- Attachment storage --------------------------------------------------------
# sqlite     : bytes stay in the attachments.content BLOB/BYTEA column
# filesystem : bytes go to ATTACHMENT_DIR/<sha256>/<filename>; the row keeps the
#              relative path. Recommended: keeps the database small.
ATTACHMENT_STORE=filesystem
ATTACHMENT_DIR=data/attachments

# --- Document model --------------------------------------------------------------
# Folder with the trained LayoutLMv3 model, loaded locally and offline by the
# backend. Leave empty until the model is added: attachments stay unclassified.
MODEL_PATH=
# A statement / invoice / receipt prediction counts as payment only at or
# above this score (0..1).
MODEL_MIN_CONFIDENCE=0.5
# Name of the business purpose this deployment serves.
PROFILE_NAME=statement_recon

# --- Frontend ----------------------------------------------------------------------
# Where the Streamlit frontend finds the backend API.
API_URL=http://127.0.0.1:8000

# --- Keep policy -----------------------------------------------------------------
# true  : store only payment documents (statements, invoices, receipts) and the
#         threads they belong to; every other message leaves just a decision_log line
# false : store every message
STORE_ONLY_PAYMENT=false

# --- Sync behaviour ------------------------------------------------------------
# How many of the newest messages the very first sync pulls. Later syncs are
# incremental and ignore this value.
INITIAL_FETCH_LIMIT=200
